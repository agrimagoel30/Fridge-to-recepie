{
  "name": "fridge-to-recipe-suite",
  "version": "1.0.0",
  "description": "Fridge-to-Recipe AI Cooking Assistant - Frontend Internship Assignment for Flam",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run start --workspace=server\" \"npm run dev --workspace=client\"",
    "start:server": "npm run start --workspace=server",
    "start:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "test": "node server/verify.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
