{
  "name": "fridge-to-recipe",
  "version": "1.0.0",
  "description": "AI-powered fridge-to-recipe cooking assistant built with React, Node.js, and Groq LLM",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run start --workspace=server\" \"npm run dev --workspace=client\"",
    "start": "npm run dev",
    "build:render": "npm install && npm run build --workspace=client",
    "start:render": "node server/index.js",
    "build": "npm run build --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
